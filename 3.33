x = int(input("Введите трёхзначное число x: "))


if not (100 <= x <= 999):
    print("Ошибка: x должно быть трёхзначным!")
else:
    c = x % 10           # последняя цифра (единицы)
    temp = x - c         # убрали последнюю цифру
    q = temp // 10       # разделили на 10
    n = 100 * c + q      # приписали c слева к q
    print("Число n:", n)
