
result = 237


# Выделяем цифры числа 237
c = result // 100      
ab = result % 100     
a = ab // 10          
b = ab % 10           

# Собираем исходное число x
x = 100 * a + 10 * b + c


print("Искомое число x:", x)

# Дополнительная проверка
print("\nПроверка:")
print(f"1. x = {x}")
print(f"2. x − последняя цифра ({c}) = {x - c}")
print(f"3. (x − c) // 10 = {(x - c) // 10}")
print(f"4. Приписываем {c} слева к {(x - c) // 10} → {c}{(x - c) // 10} = {result}")
