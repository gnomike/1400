n = int(input("Введите натуральное число (n > 99): "))

# Проверка условия n > 99
if n <= 99:
    print("Ошибка: число должно быть больше 99!")
else:
    # а) Число десятков
    tens = (n % 100) // 10
    print("а) Число десятков:", tens)
    
    # б) Число сотен
    hundreds = (n // 100) % 10
    print("б) Число сотен:", hundreds)
