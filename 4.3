import math

# Ввод значения x от пользователя
x = float(input("Введите значение x: "))

# Расчёт y в зависимости от условия
if x > 0:
    y = math.sin(x) ** 2  # y = sin²x при x > 0
else:
    y = 1 + 2 * (math.sin(x) ** 2)  # y = 1 + 2sin²x при x ≤ 0

# Вывод результата
print(f"При x = {x} значение y = {y}")

