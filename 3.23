number = int(input("Введите трёхзначное число: "))


# Выделяем последнюю цифру (единицы)
last_digit = number % 10


# Получаем первые две цифры (сотни и десятки)
first_two = number // 10  # целочисленное деление на 10 «отрезает» последнюю цифру


# Формируем новое число: последняя цифра * 100 + первые две цифры
result = last_digit * 100 + first_two


print(f"Полученное число: {result}")
