number = int(input("Введите трёхзначное число: "))


# Выделяем цифры
units = number % 10           # единицы (последняя цифра)
tens = (number // 10) % 10    # десятки (средняя цифра)
hundreds = number // 100       # сотни (первая цифра)

# Собираем число в обратном порядке: единицы → десятки → сотни
reversed_number = units * 100 + tens * 10 + hundreds

print(f"Число справа налево: {reversed_number}")
