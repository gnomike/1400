n = int(input("Введите натуральное число (n > 999): "))

# Проверка условия n > 999
if n <= 999:
    print("Ошибка: число должно быть больше 999!")
else:
    # а) Число сотен
    hundreds = (n // 100) % 10
    print("а) Число сотен:", hundreds)
    
    # б) Число тысяч
    thousands = n // 1000
    print("б) Число тысяч:", thousands)
