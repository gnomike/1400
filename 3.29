n = int(input("Введите натуральное число (n > 9): "))

# Проверка условия n > 9
if n <= 9:
    print("Ошибка: число должно быть больше 9!")
else:
    # а) Число единиц
    units = n % 10
    print("а) Число единиц:", units)
    
    # б) Число десятков
    tens = (n // 10) % 10
    print("б) Число десятков:", tens)
