import math

# Ввод значения x от пользователя
x = float(input("Введите значение x: "))

# Вычисляем k в зависимости от sin(x)
if math.sin(x) >= 0:
    k = x ** 2  # k = x^2, если sin(x) >= 0
else:
    k = abs(x)  # k = |x|, если sin(x) < 0

# Вычисляем f(x) в зависимости от соотношения x и k
if x < k:
    f_x = abs(x)  # f(x) = |x|, если x < k
else:
    f_x = k * x  # f(x) = kx, если x >= k

# Вывод результатов
print(f"x = {x}")
print(f"sin(x) = {math.sin(x):.6f}")
print(f"k = {k}")
print(f"f(x) = {f_x}")
