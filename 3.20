# Ввод трёхзначного числа
number = int(input("Введите трёхзначное число: "))


# а) Число единиц (последняя цифра)
units = number % 10


# б) Число десятков (средняя цифра)
tens = (number // 10) % 10

# в) Сумма цифр
sum_digits = (number // 100) + tens + units  # сотни + десятки + единицы


# г) Произведение цифр
product_digits = (number // 100) * tens * units  # сотни * десятки * единицы


# Вывод результатов
print(f"а) Число единиц: {units}")
print(f"б) Число десятков: {tens}")
print(f"в) Сумма цифр: {sum_digits}")
print(f"г) Произведение цифр: {product_digits}")
