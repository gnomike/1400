f = int(input("Введите факториал: "))

original = f
n = 1

while f > 1:
    if f % (n + 1) != 0:  # если не делится нацело — ошибка
        break
    n += 1
    f //= n

if f == 1:
    print(f"Число n, для которого n = {original}, равно {n}")
else:
    print("Данное число не является факториалом натурального числа.")
